/* Styles for the whole app. Textual CSS: https://textual.textualize.io/guide/CSS/ */

Screen {
    background: #181818;   /* VS Code's terminal background (Dark Modern) */
    color: #cdd6f4;             /* default text colour */
    align: center middle;
    border: round #fab387;    
    border-subtitle-color: #a6adc8;
}

#title {
    dock: top;
    width: 100%;
    content-align: right middle;
    color: #fab387;
    text-style: bold;
}

#copyright {
    dock: bottom;
    width: 100%;
    content-align: right middle;
    color: #a6adc8;
    text-style: italic;
}

Footer {
    background: #181818;
}

Footer .footer-key--key {
    color: #fab387;
}

/* Notifications (self.notify) */
Toast {
    width: 40;
    padding: 0 1;
    background: #313244;  /* a bit lighter than the screen */
    content-align: center middle;
    color: #cdd6f4;
    border: round #fab387;
}

Toast .toast--title {
    color: #fab387;
    text-style: bold;
}

/* One colour per severity */
Toast.-information { border: round #a6e3a1; }   /* green */
Toast.-information .toast--title { color: #a6e3a1; }

Toast.-warning { border: round #f9e2af; }       /* yellow */
Toast.-warning .toast--title { color: #f9e2af; }

Toast.-error { border: round #f38ba8; }         /* red */
Toast.-error .toast--title { color: #f38ba8; }

/* Scrollbars everywhere: thin, in the theme's colours */
* {
    scrollbar-size: 1 1;                     /* horizontal bar 1 row tall, vertical bar 1 column wide */
    scrollbar-color: #fab387;                /* the part you drag: orange */
    scrollbar-color-hover: #f9c7a3;          /* a lighter orange under the mouse */
    scrollbar-color-active: #fab387;         /* while dragging */
    scrollbar-background: #181818;           /* behind the line: same as the screen */
    scrollbar-background-hover: #181818;
    scrollbar-background-active: #181818;
    scrollbar-corner-color: #181818;         /* the square where the two bars meet */
}
