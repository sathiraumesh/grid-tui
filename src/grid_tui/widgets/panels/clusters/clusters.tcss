/* Styles for the ClusterPanel */

ClusterPanel {
    height: 1fr;
}

ClusterPanel DataTable {
    height: 1fr;
    background: #181818;
}

ClusterPanel DataTable > .datatable--header {
    color: #fab387;
    background: #313244;
    text-style: bold;
}

ClusterPanel DataTable > .datatable--cursor {
    background: #45475a;
}

/* The site dropdown: one small row, on the left */

ClusterPanel #toolbar {
    height: 1;
    margin-bottom: 1;
    align-horizontal: left;       /* the label and dropdown at the left */
}

ClusterPanel #site-label {
    width: auto;
    padding: 0 1;
    color: #a6adc8;
}

ClusterPanel #site-select {
    width: 22;
}

ClusterPanel #site-select > SelectCurrent {
    background: #313244;
    padding: 0 1;
}

ClusterPanel #site-select:focus > SelectCurrent {
    background: #45475a;           /* a bit lighter when it has focus */
}

ClusterPanel #site-select > SelectCurrent .arrow {
    color: #fab387;                /* orange arrow */
}

ClusterPanel #site-select > SelectOverlay {
    border: round #fab387;
    background: #313244;
}

/* The SSH button, just after the dropdown */

ClusterPanel #ssh-button {
    min-width: 8;
    margin-left: 2;
    padding: 0 1;
    background: #313244;
    color: #a6e3a1;                /* green: it opens something live */
    text-style: bold;
}

ClusterPanel #ssh-button:hover,
ClusterPanel #ssh-button:focus {
    background: #45475a;
    text-style: bold;
}
