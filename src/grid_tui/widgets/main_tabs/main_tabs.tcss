/* Styles for the MainTabs widget */

MainTabs,
MainTabs TabbedContent {
    height: 1fr;
}

MainTabs TabPane > * {
    height: 1fr;            /* panels fill the tab (otherwise they can be 0 rows tall) */
}

MainTabs Tab {
    color: #a6adc8;
}

MainTabs Tab.-active {
    color: #fab387;
    text-style: bold;
}

MainTabs Underline > .underline--bar {
    color: #fab387;
    background: #45475a;
}
