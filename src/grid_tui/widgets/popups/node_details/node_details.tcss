/* The node details pop-up */

NodeDetails {
    align: center middle;          /* the box in the middle of the screen */
    background: #11111b 70%;       /* dim the app behind it */
}

NodeDetails #details {
    width: 80%;
    max-width: 100;
    height: 85%;
    background: #181818;
    border: round #fab387;
    border-title-color: #fab387;
    border-title-style: bold;
    border-subtitle-color: #a6adc8;
    border-subtitle-align: right;
    padding: 0 2;
}

NodeDetails #details-body {
    height: 1fr;
}

NodeDetails .section-title {
    margin-top: 1;
    color: #fab387;
    text-style: bold;
}

NodeDetails .section {
    padding-left: 2;
}
